{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@flihub/core": ["packages/core/src/index.ts"],
      "@flihub/workflows": ["packages/workflows/src/index.ts"],
      "@flihub/persistence": ["packages/persistence/src/index.ts"],
      "@flihub/league": ["packages/league/src/index.ts"],
      "@flihub/business": ["packages/business/src/index.ts"],
      "@flihub/community": ["packages/community/src/index.ts"],
      "@flihub/fantasy": ["packages/fantasy/src/index.ts"],
      "@flihub/sponsorship": ["packages/sponsorship/src/index.ts"],
      "@flihub/content": ["packages/content/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "eslint.config.js", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
